{"nodes": [{"id": "analysis_flip_rates_chart", "label": "Flip Rates Figure (flip rate vs A and strict flip rate by condition and model)", "file_type": "image", "source_file": "analysis/flip_rates.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-panel grouped bar chart. It compares how often each model's prediction flips from condition A under 8 conditions (T1, T2, T3, LC, NE, UC, D, NEG). Condition D causes by far the most flips, and mBERT is the least robust there."}, {"id": "analysis_flip_rates_flip_rate_vs_a", "label": "Flip Rate vs A", "file_type": "concept", "source_file": "analysis/flip_rates.png", "source_location": "top panel", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Share of items whose prediction changes relative to condition A. Approximate readings: T1 ~7%, T2 ~12-14%, T3 ~18-19%, LC ~8-11%, NE ~1-2%, UC ~11-13%, D mBERT ~58% / XLM-R ~34% / MuRIL ~29%, NEG ~9-13%."}, {"id": "analysis_flip_rates_strict_flip_rate", "label": "Strict Flip Rate (A prediction correct)", "file_type": "concept", "source_file": "analysis/flip_rates.png", "source_location": "bottom panel", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flip rate restricted to items where the A prediction was correct, so it isolates cases where a correct answer is broken. The pattern matches the top panel. Approximate D values: mBERT ~62%, XLM-R ~28%, MuRIL ~25.5%. All other conditions stay at or below ~16%."}, {"id": "analysis_flip_rates_seed_disagreement_baseline", "label": "Seed Disagreement on A (dotted baseline)", "file_type": "concept", "source_file": "analysis/flip_rates.png", "source_location": "top panel dotted lines", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "How often different training seeds disagree on condition A, labelled as a different quantity from the flip rate. It works as a noise reference. Approximate values: XLM-R ~18.5%, mBERT ~17.8%, MuRIL ~12.8%. Only condition D, and T3 for MuRIL, clearly go above the model's own seed noise."}, {"id": "analysis_flip_rates_cluster_bootstrap_ci", "label": "95% CI via Cluster Bootstrap (sentence ids, 3 seeds pooled, 2,000 resamples)", "file_type": "concept", "source_file": "analysis/flip_rates.png", "source_location": "footnote", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "analysis_flip_rates_mbert", "label": "bert-base-multilingual-cased", "file_type": "concept", "source_file": "analysis/flip_rates.png", "source_location": "legend", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most fragile under condition D: about 58% flips, and about 62% strict flips."}, {"id": "analysis_flip_rates_xlm_roberta", "label": "xlm-roberta-base", "file_type": "concept", "source_file": "analysis/flip_rates.png", "source_location": "legend", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Highest flip rates under NE and NEG, and the highest seed-disagreement baseline."}, {"id": "analysis_flip_rates_muril", "label": "muril-base-cased", "file_type": "concept", "source_file": "analysis/flip_rates.png", "source_location": "legend", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lowest flip rate under D and the lowest seed-disagreement baseline (~12.8%). It may be the most robust model on code-mixed input."}, {"id": "analysis_flip_rates_conditions", "label": "Perturbation Conditions T1, T2, T3, LC, NE, UC, D, NEG", "file_type": "concept", "source_file": "analysis/flip_rates.png", "source_location": "x-axis", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AMBIGUOUS: the abbreviations are not defined in the figure. One plausible reading is T1-T3 = transliteration levels, LC/UC = lower/upper case, NE = named entities, D = a script or dropping change, NEG = negation. This reading is not confirmed."}, {"id": "analysis_flip_rates_condition_d", "label": "Condition D", "file_type": "concept", "source_file": "analysis/flip_rates.png", "source_location": "x-axis", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The most disruptive condition by a wide margin for all three models. Its meaning is not stated in the figure."}, {"id": "analysis_flip_rates_condition_ne", "label": "Condition NE", "file_type": "concept", "source_file": "analysis/flip_rates.png", "source_location": "x-axis", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Barely changes predictions (about 0.5-2%). It can serve as a near-invariance control."}], "edges": [{"source": "analysis_flip_rates_chart", "target": "analysis_flip_rates_flip_rate_vs_a", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "analysis/flip_rates.png", "source_location": "top panel", "weight": 1.0}, {"source": "analysis_flip_rates_chart", "target": "analysis_flip_rates_strict_flip_rate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "analysis/flip_rates.png", "source_location": "bottom panel", "weight": 1.0}, {"source": "analysis_flip_rates_chart", "target": "analysis_flip_rates_seed_disagreement_baseline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "analysis/flip_rates.png", "source_location": "top panel", "weight": 1.0}, {"source": "analysis_flip_rates_chart", "target": "analysis_flip_rates_cluster_bootstrap_ci", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "analysis/flip_rates.png", "source_location": "footnote", "weight": 1.0}, {"source": "analysis_flip_rates_chart", "target": "analysis_flip_rates_mbert", "relation": "references", "confidence": "EXTRA